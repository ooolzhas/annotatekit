{
  "name": "annotate-ios",
  "version": "0.4.1",
  "description": "AnnotateKit for React Native and Expo (iOS), and the annotate CLI that delivers visual feedback from your running iOS app to coding agents (MCP server, watcher, headless runner).",
  "homepage": "https://annotatekit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooolzhas/annotatekit.git",
    "directory": "packaging/npm"
  },
  "bugs": "https://github.com/ooolzhas/annotatekit/issues",
  "license": "MIT",
  "author": "Olzhas Beisenbayev (https://github.com/ooolzhas)",
  "bin": {
    "annotate": "bin/annotate"
  },
  "files": [
    "bin/annotate",
    "app.plugin.js",
    "AnnotateKit.podspec",
    "Sources/AnnotateCore",
    "Sources/AnnotateKit",
    "!Sources/**/*.docc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "keywords": [
    "ios",
    "swiftui",
    "react-native",
    "expo",
    "expo-config-plugin",
    "annotation",
    "visual-feedback",
    "mcp",
    "mcp-server",
    "claude",
    "cursor",
    "codex",
    "simulator"
  ]
}
